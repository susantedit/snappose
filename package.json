{
  "name": "snap-pose",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "npx expo start",
    "dev": "npx expo start",
    "android": "npx expo start --android",
    "ios": "npx expo start --ios",
    "web": "npx expo start --web",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "expo": "~51.0.0",
    "expo-router": "~3.5.0",
    "react": "18.2.0",
    "react-native": "0.74.0",
    "expo-status-bar": "~1.12.1",
    "expo-camera": "~15.0.0",
    "expo-media-library": "~16.0.0",
    "expo-file-system": "~17.0.0",
    "expo-sqlite": "~14.0.0",
    "expo-secure-store": "~13.0.0",
    "expo-font": "~12.0.0",
    "expo-splash-screen": "~0.27.0",
    "expo-haptics": "~13.0.0",
    "expo-speech": "~12.0.0",
    "expo-localization": "~15.0.0",
    "expo-updates": "~0.25.0",
    "expo-build-properties": "~0.12.0",
    "react-native-mmkv": "^2.12.2",
    "zustand": "^4.5.2",
    "@tanstack/react-query": "^5.40.0",
    "@tanstack/react-query-persist-client": "^5.40.0",
    "react-native-reanimated": "~3.10.0",
    "react-native-gesture-handler": "~2.16.0",
    "@shopify/react-native-skia": "^1.3.0",
    "@shopify/flash-list": "^1.6.4",
    "nativewind": "^4.0.1",
    "react-native-google-mobile-ads": "^13.1.0",
    "@react-native-firebase/app": "^20.0.0",
    "@react-native-firebase/auth": "^20.0.0",
    "@react-native-firebase/analytics": "^20.0.0",
    "@react-native-firebase/crashlytics": "^20.0.0",
    "axios": "^1.7.2",
    "i18n-js": "^4.4.3",
    "react-hook-form": "^7.52.0",
    "@hookform/resolvers": "^3.6.0",
    "zod": "^3.23.8",
    "react-native-safe-area-context": "4.10.1",
    "react-native-screens": "3.31.1",
    "@react-navigation/native": "^6.1.17"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/react": "~18.2.79",
    "@types/react-native": "0.73.0",
    "@types/jest": "^29.5.12",
    "@types/i18n-js": "^3.8.9",
    "typescript": "^5.3.3",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~8.0.0",
    "prettier": "^3.3.2",
    "jest": "^29.7.0",
    "jest-expo": "~51.0.0",
    "@testing-library/react-native": "12.5.1",
    "@testing-library/jest-native": "^5.4.3",
    "react-test-renderer": "18.2.0",
    "fast-check": "^3.19.0",
    "tailwindcss": "^3.4.4",
    "babel-jest": "^29.7.0"
  },
  "overrides": {
    "react-test-renderer": "18.2.0"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|nativewind|@shopify/.*)"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.d.ts",
      "!src/**/__tests__/**"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 85
      }
    }
  },
  "private": true
}
